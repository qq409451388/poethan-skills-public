{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doris Diagnostic Report",
  "type": "object",
  "required": ["schemaVersion", "server", "generatedAt", "summary", "findings", "outputs", "enhancedByAI"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "server": {"type": "string"},
    "generatedAt": {"type": "string"},
    "summary": {"type": "string"},
    "enhancedByAI": {"type": "boolean"},
    "findings": {"type": "array"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pluginID", "pluginName", "exitCode", "text", "collectedAt"]
      }
    }
  }
}
