{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poethan.dev/sentinel/report.schema.json",
  "title": "Poethan Sentinel Diagnostic Report",
  "type": "object",
  "required": ["id", "server", "plugin", "status", "createdAt", "summary", "findings", "rawOutput"],
  "properties": {
    "id": {"type": "string"},
    "server": {"type": "object"},
    "plugin": {"type": "object"},
    "status": {"enum": ["completed", "failed", "cancelled"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "summary": {"type": "string"},
    "findings": {"type": "array"},
    "rawOutput": {"type": "string"},
    "reportTemplate": {"type": ["boolean", "null"], "description": "生成时是否使用了插件 HTML 报告模板；历史报告的呈现方式以此为准，null 表示改动前保存的老报告。"},
    "ai": {"type": ["object", "null"]},
    "audit": {"type": "object"}
  }
}
