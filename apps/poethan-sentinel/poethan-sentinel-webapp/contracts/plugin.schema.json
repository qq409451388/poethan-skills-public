{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poethan.dev/sentinel/plugin.schema.json",
  "title": "Poethan Sentinel Plugin Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "entrypoint", "defaultMode", "modes", "configuration"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 500},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "toolType": {"enum": ["plugin", "local_script", "server_script"]},
    "entrypoint": {"type": "string", "minLength": 1},
    "language": {"enum": ["python", "bash"]},
    "outputLimit": {"type": "integer", "minimum": 1000, "maximum": 10000000},
    "publisher": {
      "type": "object",
      "required": ["id", "keyId"],
      "properties": {"id": {"type": "string"}, "keyId": {"type": "string"}}
    },
    "permissions": {
      "type": "object",
      "properties": {
        "sudo": {"type": "boolean"},
        "perf": {"type": "boolean"},
        "network": {"type": "boolean"},
        "readLogs": {"type": "boolean"},
        "databaseReadOnly": {"type": "boolean"}
      }
    },
    "defaultMode": {"type": "string"},
    "modes": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "help": {"type": "string"}}}
    },
    "configuration": {
      "type": "object", "required": ["fields"],
      "properties": {"fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}}
    },
    "report": {"type": "object", "required": ["schema", "template"], "properties": {"schema": {"type": "string"}, "template": {"type": "string"}}}
  },
  "$defs": {
    "field": {
      "type": "object", "required": ["key", "label", "type", "section"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "label": {"type": "string"},
        "type": {"enum": ["text", "path", "integer", "url", "password", "boolean", "choice"]},
        "section": {"type": "string"},
        "default": {"type": ["string", "number", "boolean"]},
        "required": {"type": "boolean"},
        "help": {"type": "string"},
        "placeholder": {"type": "string"},
        "options": {"type": "array", "items": {"type": "object", "required": ["value", "label"], "properties": {"value": {"type": "string"}, "label": {"type": "string"}}}}
      }
    }
  }
}
