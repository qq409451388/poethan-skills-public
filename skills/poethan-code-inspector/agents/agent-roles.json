{
  "version": 18,
  "skill_name": "poethan-code-inspector",
  "runtime": {
    "local_home": "${HOME}/.agent-review",
    "database": "${HOME}/.agent-review/data/review.db"
  },
  "agents": [
    "codex",
    "trae-cn",
    "claude",
    "dsh",
    "opencode"
  ],
  "bindings": {
    "developer": {
      "alias": "developer"
    },
    "inspector": {
      "alias": "inspector"
    }
  },
  "roles": {
    "developer": {
      "session_selector": "dev",
      "commands": [
        "task-list",
        "task-get",
        "issue-list",
        "issue-list-pending-review",
        "issue-get",
        "issue-context-get",
        "stage-list",
        "stage-get",
        "stage-history-get",
        "watch-probe",
        "stage-prepare",
        "discussion-append",
        "discussion-amend",
        "discussion-list",
        "discussion-get",
        "decision-list",
        "activity-list",
        "activity-list-recent",
        "activity-get",
        "activity-revision-list",
        "issue-update-status",
        "issue-update-status-batch",
        "design-submit",
        "design-preview",
        "stage-submit",
        "implementation-submit",
        "activity-append",
        "activity-amend",
        "candidate-submit",
        "candidate-list",
        "discussion-topic-create",
        "discussion-topic-list"
      ],
      "responsibilities": [
        "依据当前 Inspector 派工授权实现并验证，普通命名和局部组织自主决定",
        "发现方案前提不成立时暂停受影响实现，提供前提、证据、影响和未知项，不必提出替代方案",
        "不擅自新增机制或改变方案方向；必要时请求 Inspector 澄清",
        "按 finding id 修复 BLOCKER/MUST，不以非阻断建议拖延交付",
        "提交实现和验证证据；可引用仍适用的 Stage/Activity，不机械重复测试",
        "只修订自己尚未被消费的文案，保留审计与原始证据",
        "报告范围外的新问题作为候选，不混入当前修复"
      ],
      "prohibited": [
        "task-create",
        "version-create",
        "issue-create",
        "issue-update-assessment",
        "design-request",
        "design-review",
        "承担 Stage Plan 制定责任",
        "stage-review",
        "自行宣布 Stage PASS",
        "human-escalate",
        "HUMAN_CONFIRMATION_REQUIRED",
        "DESIGN_APPROVED",
        "CONFIRMED",
        "direct-sql",
        "在设计状态修改业务代码或提交实现",
        "绕过 Inspector 请求 Human 技术决策",
        "design-dispatch",
        "implementation-review",
        "在没有有效派工授权时通过状态或活动命令推进实现",
        "把个人偏好包装成推翻方案的事实"
      ]
    },
    "inspector": {
      "session_selector": "insp",
      "includes": [
        "verification"
      ],
      "commands": [
        "task-create",
        "task-resolve",
        "task-list",
        "task-get",
        "task-update",
        "task-update-status",
        "version-create",
        "issue-create",
        "issue-create-batch",
        "issue-list",
        "issue-list-pending-review",
        "issue-get",
        "issue-context-get",
        "stage-list",
        "stage-get",
        "stage-history-get",
        "watch-probe",
        "issue-update-assessment",
        "issue-update-assessment-batch",
        "issue-update-body",
        "issue-update-status",
        "issue-update-status-batch",
        "design-request",
        "design-choice-record",
        "design-preview",
        "design-review",
        "stage-review",
        "human-escalate",
        "human-brief",
        "discussion-append",
        "discussion-amend",
        "discussion-list",
        "discussion-get",
        "decision-record",
        "decision-list",
        "activity-append",
        "fast-review-record",
        "activity-amend",
        "activity-list",
        "activity-list-recent",
        "activity-get",
        "activity-revision-list",
        "candidate-list",
        "candidate-update-status",
        "issue-set-progress",
        "issue-set-difficulty",
        "issue-set-assignment",
        "discussion-topic-create",
        "discussion-topic-list",
        "implementation-review",
        "design-dispatch"
      ],
      "responsibilities": [
        "理解原始需求、核实事实与原因，制定可执行方案、边界和验收标准",
        "用 design dispatch 原子发布方案并派工；只在已有授权不足时询问 Human",
        "独立判断方案深度和是否分 Stage，复杂方案也可 direct",
        "用 impl review 按原始需求和实际证据验收并收口，设计错误由 Inspector 修正",
        "澄清普通细节；方向变化时修订方案，撤销旧授权和旧 Stage Plan",
        "按事实评估 difficulty 和进度，进度可随业务动作更新，不按活动数推算",
        "遵守现有四级 finding 和审核收敛约束，复用有效证据",
        "保持最小充分设计；新增机制说明具体收益、成本和失败路径，禁止为未来假设过度加固",
        "必要时整理真实业务取舍、范围变化和风险授权供 Human 决定",
        "创建或复用任务、问题与候选，维护简明中文记录"
      ],
      "prohibited": [
        "implementation-submit",
        "把 Stage Plan 创建与设计批准拆成两个操作",
        "要求用户打开 Web 或通读 Issue/Agent 讨论才能做决定",
        "用未解释的技术辞藻直接向用户提问",
        "对明确 Bug、唯一合理实现或用户已明确允许的变化重复提问",
        "把应由用户确认的关键设计标记为 not-needed",
        "用 SHOULD/NIT 阻断 Stage",
        "在后续 Review 无依据新增优化意见",
        "BLOCKER/MUST 清零后继续 Review",
        "human-confirmation-resolve",
        "以普通不确定性或省事为由升级 Human",
        "modify-business-code",
        "direct-sql",
        "在 difficulty 或 Issue 中写入具体模型名称与模型能力映射",
        "在 difficulty_reason 或 Issue 正文写入执行者等级、职称或“该派谁做”",
        "伪造 Developer 设计提交",
        "仅以照方案实现代替原始需求验收",
        "对简单问题强制长模板或机械分 Stage",
        "为了限制过度设计再建立额外审批流程"
      ]
    },
    "human": {
      "session_selector": "human",
      "commands": [
        "issue-set-progress",
        "task-create",
        "task-resolve",
        "task-list",
        "task-get",
        "task-update",
        "task-update-status",
        "version-create",
        "issue-create",
        "issue-create-batch",
        "issue-list",
        "issue-list-pending-review",
        "issue-get",
        "issue-context-get",
        "stage-list",
        "stage-get",
        "stage-history-get",
        "watch-probe",
        "stage-prepare",
        "issue-update-assessment",
        "issue-update-assessment-batch",
        "issue-update-body",
        "issue-update-status",
        "issue-update-status-batch",
        "design-request",
        "design-submit",
        "design-preview",
        "design-review",
        "stage-submit",
        "stage-review",
        "human-confirmation-resolve",
        "human-brief",
        "implementation-submit",
        "discussion-append",
        "discussion-amend",
        "discussion-list",
        "discussion-get",
        "decision-list",
        "activity-append",
        "activity-list",
        "activity-list-recent",
        "activity-get",
        "activity-revision-list",
        "candidate-submit",
        "candidate-list",
        "candidate-update-status",
        "issue-set-difficulty",
        "issue-set-assignment",
        "discussion-topic-create",
        "discussion-topic-list",
        "implementation-review"
      ],
      "responsibilities": [
        "监督异常流程",
        "对 Agent 无法获得的业务事实、事实归属或重大不可逆数据风险作最终决定",
        "通过 human-confirmation-resolve 恢复自动工作流",
        "以最高管理权限设置任一合法 Task 或 Issue 状态",
        "必要时进行人工管理与纠错"
      ],
      "prohibited": [
        "human-escalate",
        "direct-sql"
      ]
    }
  }
}
