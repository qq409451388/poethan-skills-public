{
  "thread_runtime": {
    "enabled": true,
    "multi_thread": {
      "enabled": false,
      "require_explicit_session_activation": true
    },
    "isolation": {
      "enabled": true,
      "granularity": "issue_operator",
      "required_capability": "thread_isolation_supported"
    },
    "concurrency": {
      "max_active_issue_threads": 3,
      "single_writer_per_thread": true,
      "single_dispatcher_per_issue_role": true
    },
    "leases": {
      "event_seconds": 900,
      "thread_seconds": 1800,
      "heartbeat_seconds": 60,
      "max_event_attempts": 3
    },
    "supervisor": {
      "poll_interval_seconds": 1,
      "recovery_interval_seconds": 60,
      "max_consecutive_errors": 3
    },
    "compact": {
      "enabled": true,
      "threshold": 0.8,
      "trigger": "stage_transition",
      "required_capability": "managed_compact_supported"
    },
    "watch": {
      "enabled": true,
      "interval_seconds": 120,
      "require_explicit_activation": true,
      "use_goal": false
    },
    "workspace": {
      "enforce_safe_write": true
    },
    "app_server": {
      "command": ["codex", "app-server", "--listen", "stdio://"],
      "request_timeout_seconds": 120,
      "turn_timeout_seconds": 1800,
      "max_retry": 2,
      "backoff_seconds": 1
    }
  }
}
